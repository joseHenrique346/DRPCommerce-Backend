# Configuração do backend local DRPCommerce.
# Formato: NOME=valor, uma variável por linha, sem aspas. Linhas com # são ignoradas.
# Este arquivo contém segredos. Não versione o config.env.

# https é o padrão e é necessário para login (cookies Secure e CSRF).
# Em https, o certificado de localhost é criado e instalado na primeira execução.
PROTOCOLO=https

# Development mantém o Swagger ativo.
ASPNETCORE_ENVIRONMENT=Development

# Bancos PostgreSQL separados, já com as migrations aplicadas.
STORECOMMERCE_CONNECTION_STRING=Host=localhost;Port=5432;Database=drpcommerce_store;Username=SEU_USUARIO;Password=SUA_SENHA;
DROPCOMMERCE_CONNECTION_STRING=Host=localhost;Port=5432;Database=drpcommerce_drop;Username=SEU_USUARIO;Password=SUA_SENHA;

# Geradas automaticamente na publicação. Precisam ser iguais no Store e no Drop.
# Mínimo de 32 caracteres cada.
Security__SigningKey=__GERAR_SIGNING_KEY__
Security__InternalServiceKey=__GERAR_SERVICE_KEY__

Security__Issuer=DRPCommerce
Security__StorefrontBaseDomain=stores.localhost

# Origem do servidor de desenvolvimento do front, liberada no CORS.
# Para mais origens, acrescente Security__AllowedOrigins__1, __2...
Security__AllowedOrigins__0=http://localhost:5173
