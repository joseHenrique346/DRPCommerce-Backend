{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=drpcommerce_store;Username=<USER>;Password=<PASSWORD>;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "Issuer": "DRPCommerce",
    "SigningKey": "",
    "InternalServiceKey": "",
    "AccessTokenMinutes": 10,
    "RefreshFamilyDays": 7,
    "InvitationHours": 48,
    "OwnershipTransferMinutes": 30,
    "ActionTokenMinutes": 30,
    "RequireConfirmedEmail": false,
    "FailedLoginThreshold": 5,
    "InitialLockoutSeconds": 30,
    "MaximumLockoutSeconds": 900,
    "FailureResetMinutes": 30,
    "StorefrontBaseDomain": "stores.localhost",
    "BackofficeUrl": "",
    "AllowedOrigins": [],
    "TrustedProxies": [],
    "AuthRequestsPerMinute": 15,
    "RefreshRequestsPerMinute": 30,
    "ApiRequestsPerMinute": 180,
    "TokenRetentionDays": 7
  }
}
