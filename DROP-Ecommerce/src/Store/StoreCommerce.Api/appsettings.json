{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "Issuer": "DRPCommerce",
    "SigningKey": "",
    "InternalServiceKey": "",
    "AccessTokenMinutes": 10,
    "RefreshFamilyDays": 7,
    "InvitationHours": 48,
    "OwnershipTransferMinutes": 30,
    "ActionTokenMinutes": 30,
    "RequireConfirmedEmail": false,
    "FailedLoginThreshold": 5,
    "InitialLockoutSeconds": 30,
    "MaximumLockoutSeconds": 900,
    "FailureResetMinutes": 30,
    "StorefrontBaseDomain": "",
    "BackofficeUrl": "",
    "AllowedOrigins": [],
    "TrustedProxies": [],
    "AuthRequestsPerMinute": 15,
    "RefreshRequestsPerMinute": 30,
    "ApiRequestsPerMinute": 180,
    "TokenRetentionDays": 7
  }
}
