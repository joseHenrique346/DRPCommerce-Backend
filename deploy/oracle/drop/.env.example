# Copie para .env na vm-api-drop e substitua os valores indicados.
# Nas senhas/segredos, mantenha aspas simples para preservar caracteres como $.
DROP_IMAGE=drpcommerce/drop:oracle-arm64
BIND_IP=10.0.2.85

DROPCOMMERCE_CONNECTION_STRING='Host=10.0.2.169;Port=5432;Database=dropcommercedb;Username=USUARIO_DROP;Password=SENHA_DROP;'

# Raiz privada do Store, sem o prefixo /api/store do Gateway.
STORECOMMERCE_API_BASE_URL=http://10.0.2.96:8080/

# Copie exatamente os valores gerados para a Vitrine.
Security__SigningKey='SUBSTITUA_CHAVE_JWT'
Security__InternalServiceKey='SUBSTITUA_CHAVE_INTERNA'
Security__Issuer=DRPCommerce

Security__TrustedProxies__0=10.0.0.7
Security__StorefrontBaseDomain=lojas.example.com
Security__BackofficeUrl=https://painel.example.com
Security__AllowedOrigins__0=https://painel.example.com
Security__AllowedOrigins__1=https://lojaexemplo.lojas.example.com
AllowedHosts=api.example.com;*.lojas.example.com;10.0.2.85;127.0.0.1;localhost
