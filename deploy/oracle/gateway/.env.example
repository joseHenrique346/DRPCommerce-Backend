# Copie para .env na vm-yarp. Este servico nao recebe credenciais dos bancos.
GATEWAY_IMAGE=drpcommerce/gateway:oracle-arm64
BIND_IP=10.0.0.7

# Arquivo PFX real na VM; somente leitura no container, cujo usuario tem UID 1654.
# O certificado deve cobrir os dominios abaixo e conter sua cadeia e chave privada.
TLS_CERTIFICATE_PATH=/opt/drpcommerce/certs/gateway.pfx
Kestrel__Certificates__Default__Password='SUBSTITUA_SENHA_PFX'

AllowedHosts=api.example.com;*.lojas.example.com;127.0.0.1;localhost
ReverseProxy__Clusters__cluster_store__Destinations__destino_principal__Address=http://10.0.2.96:8080/
ReverseProxy__Clusters__cluster_drop__Destinations__destino_principal__Address=http://10.0.2.85:8080/
