# Copie para .env na vm-api-vitrine e substitua os valores indicados.
# Nas senhas/segredos, mantenha aspas simples para preservar caracteres como $.
STORE_IMAGE=drpcommerce/store:oracle-arm64
BIND_IP=10.0.2.96

STORECOMMERCE_CONNECTION_STRING='Host=10.0.2.169;Port=5433;Database=storecommercedb;Username=USUARIO_STORE;Password=SENHA_STORE;'

# Gere dois valores diferentes com openssl rand -hex 32 (executar duas vezes).
# Copie os mesmos valores para o Drop. Nao gere chaves diferentes por API.
Security__SigningKey='SUBSTITUA_CHAVE_JWT'
Security__InternalServiceKey='SUBSTITUA_CHAVE_INTERNA'
Security__Issuer=DRPCommerce

# IP privado de saida do YARP, conforme observado na VM/API.
Security__TrustedProxies__0=10.0.0.7
Security__StorefrontBaseDomain=lojas.example.com
Security__BackofficeUrl=https://painel.example.com
Security__AllowedOrigins__0=https://painel.example.com
Security__AllowedOrigins__1=https://lojaexemplo.lojas.example.com

# Incluir os hosts reais; 127.0.0.1 e localhost permitem o health check interno.
# O IP privado permite chamadas diretas do Drop para a raiz privada do Store.
AllowedHosts=api.example.com;*.lojas.example.com;10.0.2.96;127.0.0.1;localhost
